# live-runner-v2/.env.example — copy to .env and fill with INFRA-OWNED secrets (never commit .env).
# All values are supplied by infra / John (GCP Secret Manager, arbitrum RPC, orch wallet).

# fal proxy key — SAME value as the BYOC stack's FAL_API_KEY
FAL_KEY=

# Arbitrum One RPC URL (mainnet)
ARB_RPC_URL=

# On-chain orchestrator address (the funded, registered orch wallet address)
ETH_ORCH_ADDR=

# Orchestrator <-> runner shared secret
LR_ORCH_SECRET=

# Public DNS hostname for this orch (must resolve to the VM's static IP)
LR_HOSTNAME=liverunner-v2-staging-1.daydream.monster

# In addition to this .env, the compose mounts two files that are NOT in git:
#   ./keystore/<wallet>.json   (orch on-chain wallet JSON, from GCP Secret Manager)
#   ./password.txt             (keystore passphrase)
